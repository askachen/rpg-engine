    "visuals": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/visual"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
