{
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 2
    },
    "content_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "saved_at": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "developer": {
      "type": "boolean"
    },
    "state": {
      "type": "object",
      "properties": {
        "map": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "minItems": 2,
          "maxItems": 2
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "period": {
          "enum": [
            "day",
            "evening",
            "late"
          ]
        },
        "money": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inventory": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "characters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "affection": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "stage": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "affection",
              "stage"
            ],
            "additionalProperties": false
          }
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "flags": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "objects": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "stock": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "period": {
                "enum": [
                  "day",
                  "evening",
                  "late"
                ]
              }
            },
            "required": [
              "event",
              "tags",
              "day",
              "period"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "map",
        "position",
        "day",
        "period",
        "money",
        "inventory",
        "characters",
        "completed",
        "flags",
        "objects",
        "stock"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "game_id",
    "version",
    "content_version",
    "saved_at",
    "developer",
    "state"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story Garden save format v2 (content references validated by Godot)"
}
